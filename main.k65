main {
    init                        // clear RAM + TIA, set stack (see _defs.k65)
    seqbrk=a=0xFF               // song position that ends an effect (0xFF = never, song loops at 102)
    {
        // rainbow              // effects/rainbow.k65 (bank core)  - disabled, re-enable by uncommenting
        // far plasma           // effects/plasma.k65  (bank bank2) - disabled
        far shapes              // effects/shapes/     (bank bank4, + banks 5, 2, 1)
        // far eqsine           // effects/eqsine.k65  (bank bank3)  - disabled
    } always                    // FIRE / SELECT switches to the next effect
}

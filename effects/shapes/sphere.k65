// ============================================================================
//  Sphere - 30 points on a sphere, rotation precomputed (sphere_data.k65, bank5).
//  Packed by symmetry (15 stored points per frame, half a turn) and in time (every 2nd frame
//  stored, the odd ones interpolated): 34 frames x 30 bytes (tools/gen_shapes.py).
// ============================================================================

bank bank5;

[ SPHERE_NPTS = 30 ]        // points (must match tools/gen_shapes.py)
var SphereAnimA = 0xF100;   // animation frames (fixed address, sphere_data.k65)
var sphere_flip  = 0xEC;    // 0x80 in the 2nd half turn (far bits flipped)
var sphere_odd   = 0xED;    // !=0: odd frame = average of 2 stored frames (EC-ED: live-shape
                            //  vertex bytes, free while the sphere is shown; set every phase)

// Sphere (bank5): 30 points symmetric under p -> -p and under the 180-degree turn about X,
// so only one point of each opposite pair is stored (15 x 2 bytes = one 30-byte frame), and
// frame f + 66 is frame f with every far bit flipped (the turn keeps the set, see gen_shapes.py).
// Only the even frames 0..66 are stored (66 = frame 0 flipped, the neighbour of frame 65);
// an odd frame is the average of the two stored frames around it (the next one is 30 bytes on).

// the stored point of the pair shape_i belongs to -> tmp3 (x byte, far bit flipped in the 2nd half
// turn), tmp4 (y byte). Odd frames: averaged with the next stored frame (far side = the first one's).
inline sphere_fetch {
    a=shape_i a&0xFE y=a a=(ptrC),y tmp3=a y++ a=(ptrC),y tmp4=a
    a=sphere_odd !={
        a=y c- a+29 y=a                                         // the same point, next stored frame
        a=(ptrC),y a&0x7F tmp1=a a=tmp3 a&0x7F c- a+tmp1 a>> tmp1=a
        a=tmp3 a&0x80 a|tmp1 tmp3=a                             // x: average | far bit
        y++ a=(ptrC),y c- a+tmp4 a>> tmp4=a                     // y: average
    }
    a=tmp3 a^sphere_flip tmp3=a
}

// Point 2k = the stored point k, point 2k+1 = its opposite = the previous point negated (tmp3/tmp4
// survive shape_place: x byte negated whole = -x and the far bit flipped, y byte 128 - y; the
// negation commutes with the far-bit flip). A phase that starts at an opposite point rebuilds its
// pair first (tmp3/tmp4 did not survive the break).
inline sphere_body {
    a=shape_i a>> >={ sphere_fetch }                            // odd start: rebuild the pair
    {
        a=shape_i a?[SPHERE_NPTS] =={ goto .done }              // all points done
        a=INTIM a?shape_tmin <{ goto .done }                    // not enough time left here
        a=shape_i a>> >={                                       // odd: the opposite point
            a=tmp4 a^0xFF c- a+129 tmp4=a a=tmp3 a^0xFF c- a+1 tmp3=a
        } else {
            sphere_fetch
        }
        shape_place
        shape_i++
    } always                                                    // (loop too long for a branch:
    .done:                                                      //  exits jump via goto)
}

// frame pointer (bank4, before the far call): the half-turn frame 0..65 -> stored frame = /2
// (34 frames of 30 bytes: frame*30 = frame*32 - frame*2, uses tmp1), odd = interpolate
inline sphere_frame {
    x=0 a=shape_frame a?[SHAPE_FRAMES/2] >={ c+ a-[SHAPE_FRAMES/2] x=0x80 }
    sphere_flip=x
    a>> y=a a=0 a+0 sphere_odd=a                // stored frame, odd = the bit shifted out
    a=y a<< tmp1=a                              // stored frame*2
    a=y a<< a<< a<< a<< a<< ptrC=a              // stored frame*32: low byte
    a=y a>> a>> a>> c- a+&>SphereAnimA ptrC+1=a //  high byte (SphereAnimA is page aligned)
    a=ptrC c+ a-tmp1 ptrC=a a=ptrC+1 a-0 ptrC+1=a   // - frame*2
}

// the tables are read through fixed-address vars, so reference their labels once (in a
// never-executed block) or the linker drops them as unused
func sphere_points {
    never { a=SphereAnim a=ShapeScale5 a=ShapeLineBand5 a=ShapeCandBase5 a=ShapeCandOff5 a=ShapeLineCand5 }
    sphere_body
}

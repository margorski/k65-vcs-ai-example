// ============================================================================
//  Pyramid - apex + square base, rotated live (bank2), points by shape_live.
// ============================================================================

bank bank2;

// rotation scratch (ptrD, shape_i, shape_tmin: all free above the picture)
var pyramid_hx = 0xE6, pyramid_hy = 0xE7, pyramid_hz = 0xCF, pyramid_g = 0xD7;

// ---------------------------------------------------------------------------
//  Live pyramid: apex T = column 1 of R, base centre h = -T/2, base corners
//  h +- (G0 + G2) = +-P and h +- (G0 - G2) = +-Q with G0/G2 = G x columns 0/2 (G = 1/sqrt(3): ShapeSinG,
//  shared with the cube)
//  (pyramid: apex (0,1,0), corners (+-G, -0.5, +-G)). Not symmetric like the diamond,
//  so the corners need their real z for the far-side bits: 14 multiplies (~1100 cycles).
//  Kept: T, +P, +Q (x byte | far bit, y byte); the far bits of -P / -Q ride in bit 7 of the
//  +P / +Q y bytes (y bytes are 1..127). -P = 2h - P = -T - P -> byte 192 - T - P, per phase.
// ---------------------------------------------------------------------------
inline pyramid_rotate {
    a=shape_frame a<< >={ c- a+[256-SHAPE_FRAMES] }       // Y angle = 2 x frame, wrapped to 0..131
    else { a?[SHAPE_FRAMES] >={ a-[SHAPE_FRAMES] } }
    y=a a=ShapeSin,y shape_sy=a a=ShapeSin+33,y shape_cy=a a=ShapeSinG+33,y shape_cyg=a
    a=ShapeSinG,y a<< a^0xFF c- a+1 pyramid_g=a          // G0 z = -G sy (double units)
    x=shape_frame                                       // X and Z angle = frame (X stays = index)
    // apex T (as the diamond's tip), h = -T/2
    a=ShapeSin,x tmp1=a a=shape_sy tmp2=a call shape_mul shape_half shape_t=a
    tmp1=a a=ShapeSin+33,x tmp2=a call shape_mul tmp4=a
    a=ShapeSin+33,x tmp1=a a=ShapeSin,x tmp2=a call shape_mul tmp3=a a=tmp4 c+ a-tmp3 shape_ovf
    tmp4=a shape_half a^0xFF c- a+1 pyramid_hx=a a=tmp4 shape_xb shape_v0x=a
    a=shape_t tmp1=a a=ShapeSin,x tmp2=a call shape_mul tmp4=a
    a=ShapeSin+33,x tmp1=a tmp2=a call shape_mul c- a+tmp4 shape_ovf
    tmp4=a shape_half a^0xFF c- a+1 pyramid_hy=a a=tmp4 shape_yb shape_v0y=a
    a=ShapeSin,x tmp1=a a=shape_cy tmp2=a call shape_mul     // z = sx*cy
    tmp4=a shape_half a^0xFF c- a+1 pyramid_hz=a a=tmp4 a&0x80 a|shape_v0x shape_v0x=a
    // corners, z first: far bits of +P/+Q -> their x bytes, of -P/-Q -> bit 7 of the y bytes
    a=ShapeSinG+33,x tmp1=a a=shape_cy tmp2=a call shape_mul tmp4=a // G2 z = G cx*cy
    a=pyramid_hz c- a+pyramid_g c- a+tmp4 a&0x80 shape_v1x=a // +P = h + G0 + G2
    a=pyramid_hz c+ a-pyramid_g c+ a-tmp4 a&0x80 shape_v1y=a // -P = h - G0 - G2
    a=pyramid_hz c- a+pyramid_g c+ a-tmp4 a&0x80 shape_v2x=a // +Q = h + G0 - G2
    a=pyramid_hz c+ a-pyramid_g c- a+tmp4 a&0x80 shape_v2y=a // -Q = h - G0 + G2
    a=ShapeSinG+33,x tmp1=a a=shape_sy tmp2=a call shape_mul shape_half shape_t=a // t2 = G cx*sy
    // x: G0 = G cy*cz, G2 = t2*cz + G sx*sz
    a=shape_cyg tmp1=a a=ShapeSin+33,x tmp2=a call shape_mul pyramid_g=a
    a=shape_t tmp1=a a=ShapeSin+33,x tmp2=a call shape_mul tmp4=a
    a=ShapeSinG,x tmp1=a a=ShapeSin,x tmp2=a call shape_mul c- a+tmp4 tmp4=a
    a=pyramid_g c+ a-tmp4 c- a+pyramid_hx shape_ovf shape_xb a|shape_v2x shape_v2x=a
    a=pyramid_g c- a+tmp4 c- a+pyramid_hx shape_ovf shape_xb a|shape_v1x shape_v1x=a
    // y: G0 = G cy*sz, G2 = t2*sz - G sx*cz
    a=shape_cyg tmp1=a a=ShapeSin,x tmp2=a call shape_mul pyramid_g=a
    a=shape_t tmp1=a a=ShapeSin,x tmp2=a call shape_mul tmp4=a
    a=ShapeSinG,x tmp1=a a=ShapeSin+33,x tmp2=a call shape_mul tmp3=a a=tmp4 c+ a-tmp3 tmp4=a
    a=pyramid_g c+ a-tmp4 c- a+pyramid_hy shape_ovf shape_yb a|shape_v2y shape_v2y=a
    a=pyramid_g c- a+tmp4 c- a+pyramid_hy shape_ovf shape_yb a|shape_v1y shape_v1y=a
}

// per point phase: -P -> shape_v3x/v3y, -Q -> shape_v4x/v4y (byte = 192 - T - corner, low 7 bits)
inline pyramid_prep {
    a=shape_v0x a&0x7F tmp1=a a=shape_v1x a&0x7F c- a+tmp1 tmp1=a
    a=[192] c+ a-tmp1 tmp1=a a=shape_v1y a&0x80 a|tmp1 shape_v3x=a
    a=shape_v1y a&0x7F c- a+shape_v0y tmp1=a a=[192] c+ a-tmp1 shape_v3y=a
    a=shape_v0x a&0x7F tmp1=a a=shape_v2x a&0x7F c- a+tmp1 tmp1=a
    a=[192] c+ a-tmp1 tmp1=a a=shape_v2y a&0x80 a|tmp1 shape_v4x=a
    a=shape_v2y a&0x7F c- a+shape_v0y tmp1=a a=[192] c+ a-tmp1 shape_v4y=a
}

func pyramid_setup {                // rotate the vertices (top of the picture)
    pyramid_rotate
}

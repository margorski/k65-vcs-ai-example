data LogoY {
    address 0xF840
    1 127 1 127 1 80 127 1 80 127 32 64 96 32 64 96
    21 40 60 92 103 115 21 40 60 92 103 115 255 11 30 49
    68 87 106 125 33 55 78 100 9 27 46 65 84 102 121 121
    121 121 121 121 70 96 100 255
}
func logo_proc7 {
    x=sp_frame x?[67] >={ a=[132] c+ a-sp_frame x=a }   // mirror: cos(N-f) = cos(f)
    a=LogoCos,x ptrC=a                              // c = 64*cos(angle)
    a=0 x=sp_shape x?5 =={ a=[29] } sp_lbase=a       // point set: 4 Atari, 5 Altair
    logo_body
}

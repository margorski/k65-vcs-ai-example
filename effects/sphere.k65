// ============================================================================
//  Sphere - tumbling 3D sphere of "flying pixels"
//
//  30 points on a sphere rotating around X, Y and Z at once. The rotation is
//  precomputed (tools/gen_sphere.py -> effects/sphere_data.k65, bank5: packed by
//  symmetry, 66 frames x 15 points); at runtime the 6502 only picks the frame, scales it (pulse) and
//  sorts the points into the kernel's object slots. The cube, pyramid and diamond are the
//  exception: their rotation is computed live every frame (cub_/pyr_/dia_setup, sphere_defs.k65).
//
//  Kernel: 15 bands of 11 lines. In every band all five objects are
//  re-positioned (P0 P1 M0 M1 BL, one line each), one HMOVE line applies the
//  fine positions and each object then draws one 2x2 px dot on its own line:
//      r0-r4 position, r5 HMOVE + colour, dots: P0 r6, P1 r7, M0 r8, M1 r9, BL r10
//  -> up to 75 dots, 5 per band. An empty slot (x = 0) simply isn't switched on.
//  A point goes to the slot whose dot line is nearest to its y (next nearest if
//  taken, dropped if the band is full).
//
//  Shape follows the song mood too (calm = cube, full = pyramid, ...). A shape change into a
//  calm part implodes the object to the centre, switches while collapsed and grows it back;
//  into an energetic part it explodes (points fly off-screen), switches, and the new shape
//  flies in from outside. Both ~0.5 s.
//
//  Colour and base rotation speed follow the song mood (sections as in EQ Sine):
//  calm = blue/slow, breakdown = red/slow, full = green/faster, build-up = purple/fastest
//  (the speed glides to the new value in ~1-2 s).
//
//  Depth: points on the far side go to P1/M1 (dim band colour), near ones to
//  P0/M0/BL (bright) - the generator marks them in bit 7 of the x byte.
//
//  Music: kick (AUDC 15 attack on ch0) -> the rotation surges (up to ~2.3x,
//  fades in ~16 frames); hat (AUDC 8 attack, ch0 or ch1) -> the sphere pulses
//  bigger (4 scale steps up to 120%, ~0.3 s).
//
//  Bank4 (code, kernel), data banks: bank5 sphere, bank2 cube + pyramid, bank1 diamond + logos.
// ============================================================================

bank bank4;

// ---------------------------------------------------------------------------
//  Per frame
// ---------------------------------------------------------------------------

// Shape for the current song position: x = songpos_seq, y = mood -> A
//   first verse: Altair logo, from the 2nd calm part on: Atari logo, otherwise the mood's shape
inline sph_target {
    a=SphModeShape,y
    x?[SPH_LOGO_SEQ] >={ a=4 }
    x?[SPH_ALTAIR_SEQ_END] <{ a=5 }
}

// ---------------------------------------------------------------------------
//  (music + animation)
// ---------------------------------------------------------------------------

// kick -> speed boost, hat -> pulse; advance the animation
inline sph_music {
    // attack = volume rises by >= 4 (kick) / >= 2 (hats are quiet, e.g. in the intro)
    a=mus_v0 a&15 y=a c+ a-sp_pv0 sp_pv0=y
    >={ tmp1=a
        a=mus_c0 a&15 a?15 =={ a=tmp1 a?4 >={ sp_boost=a=32 } }      // kick: speed surge
        else { a?8 =={ a=tmp1 a?2 >={ sp_pulse=a=15 } } }            // hat: pulse
    }
    a=mus_v1 a&15 y=a c+ a-sp_pv1 sp_pv1=y
    >={ tmp1=a a=mus_c1 a&15 a?8 =={ a=tmp1 a?2 >={ sp_pulse=a=15 } } }

    a=sp_pulse !={ sp_pulse-- }
    a=sp_boost !={ c+ a-2 <{ a=0 } sp_boost=a }  // surge fades in ~16 frames

    // base speed glides (1/256 per frame) towards the speed of the current song mood
    // shape: when the mood asks for another shape, implode, switch while collapsed, grow back
    x=songpos_seq y=SphSongMode,x
    sph_target tmp1=a                                       // shape wanted now
    a=sp_tt !={
        sp_tt--
        a=sp_tt a?12 =={ a=tmp1 sp_shape=a }                // collapsed / blown away: switch
    } else {
        a=tmp1 a?sp_shape !={                               // new shape wanted: start the
            sp_tt=a=24 a=SphModeTrans,y sp_ttype=a          //  mood's transition
        }
    }
    x=sp_tt
    a=sp_ttype !={ a=SphTransG,x sp_gr=a a=0 sp_sh=a }     // explosion
    else { a=SphTrans,x sp_sh=a a=0 sp_gr=a }               // implosion
    a=SphModeSpeed,y
    a?sp_speed !={ <{ sp_speed-- } else { sp_speed++ } }

    // position += base speed + boost*4 (8.8 fixed point, wraps at SPH_FRAMES)
    a=sp_boost a<< a<< c- a+sp_speed tmp1=a
    a=0 a+0 tmp2=a                                  // carry -> +1 frame
    a=sp_frac c- a+tmp1 sp_frac=a
    a=sp_frame a+tmp2
    a?[SPH_FRAMES] >={ c+ a-[SPH_FRAMES] }
    sp_frame=a
}

// next points of the frame (from sp_i, while time is left) -> band slots
inline sph_points {
    a=sp_tt !={ a=sp_tmin c- a+[SPH_TMIN_TRANS] sp_tmin=a }   // transitions: slower points (grow loops)
    a=sp_pulse a>> a>> tmp1=a                       // scale level 0..3
    a>> c- a+&>SphScaleA ptrD+1=a
    a=tmp1 a>>> a>>> a&0x80 ptrD=a                  // (level&1)*128
    a=sp_shape !={
        a?2 <{ far cub_proc2 }                      // cube: bank2 (rotated live)
        else { a?2 =={ far pyr_proc2 }              // pyramid: bank2 (rotated live)
               else { a?3 =={ far dia_proc1 }       // diamond: bank1 (rotated live)
                      else { far logo_proc1 } } }   // logos: bank1
    } else {
        // sphere (bank5): 66 stored frames of 32 bytes, the second half turn = far bits flipped
        x=0 a=sp_frame a?[SPH_FRAMES/2] >={ c+ a-[SPH_FRAMES/2] x=0x80 }
        sp_flip=x
        y=a a<< a<< a<< a<< a<< ptrC=a               // (frame*32) low byte
        a=y a>> a>> a>> c- a+&>SphAnimA ptrC+1=a    // + frame/8 pages
        far sph_proc5
    }
}



// ---------------------------------------------------------------------------
//  Kernel
// ---------------------------------------------------------------------------

// fine/coarse positioning after the line's preamble: A = x input
inline SphDivP0 { nocross { { a-15 }>= a^7 a<< a<< a<< a<< hp0h=a *2 rp0=a } }
inline SphDivP1 { nocross { { a-15 }>= a^7 a<< a<< a<< a<< hp1h=a *2 rp1=a } }
inline SphDivM0 { nocross { { a-15 }>= a^7 a<< a<< a<< a<< hm0h=a *2 rm0=a } }
inline SphDivM1 { nocross { { a-15 }>= a^7 a<< a<< a<< a<< hm1h=a *2 rm1=a } }
inline SphDivBL { nocross { { a-15 }>= a^7 a<< a<< a<< a<< hbh=a *2 rb=a } }

// X = 0 all the time (the "off" value), Y = band. Starts on the first band line (SPH_TOP).
inline sph_kernel {
    y=0
    {
        a=sp_bx0,y c+ wsync em1=x SphDivP0          // r0: P0 (preamble: M1 dot off)
        a=sp_bx1,y c+ wsync eb=x  SphDivP1          // r1: P1 (preamble: BL dot off)
        a=sp_bx2,y c+ wsync       SphDivM0          // r2: M0
        a=sp_bx3,y c+ wsync       SphDivM1          // r3: M1
        a=sp_bx4,y c+ wsync       SphDivBL          // r4: BL
        wsync hmove=a                               // r5: fine positions + band colours
        a=(sp_colp),y cp0=a cpf=a                   //  front objects: bright
        a=y c- a+16 y=a a=(sp_colp),y cp1=a         //  back objects (P1/M1): dim
        a=y c+ a-16 y=a
        wsync a=sp_bx0,y !={ a=3 } gp0=a            // r6: P0 dot on  (GRP %11, ENAxx bit 1)
        wsync a=sp_bx1,y !={ a=3 } gp1=a            // r7: P1 on
        wsync gp0=x a=sp_bx2,y !={ a=3 } em0=a      // r8: P0 off, M0 on
        wsync gp1=x a=sp_bx3,y !={ a=3 } em1=a      // r9: P1 off, M1 on
        wsync em0=x a=sp_bx4,y !={ a=3 } eb=a       // r10: M0 off, BL on
        sp_bx0,y=x sp_bx1,y=x sp_bx2,y=x sp_bx3,y=x sp_bx4,y=x  // band drawn: clear it for the next frame
        y++ y?[SPH_NB] =={ goto sph_kernel_done }
    } always
    sph_kernel_done:
    wsync em1=x eb=x
}


// ---------------------------------------------------------------------------
//  Effect entry point
// ---------------------------------------------------------------------------
func sphere {
    ctpf=a=0x10 cbg=a=0 cpf=a pf0=pf1=pf2=a gp0=gp1=a em0=em1=a eb=a  // ball 2 px, no PF
    rep0=rep1=a vdp0=vdp1=a vdb=a
    ns0=ns1=a=0x10                              // missiles 2 px, players 1 copy
    a=0 x=[0x4F] { sp_bx,x=a x-- }>=0           // clear 80-CF
    sp_pv0=a sp_pv1=a sp_i=a
    sp_speed=a=[SPH_SPEED]
    a=0 sp_tt=a sp_sh=a sp_gr=a sp_ttype=a
    x=songpos_seq y=SphSongMode,x sph_target sp_shape=a     // start with the current shape
    a=64 dia_tx=a dia_ty=a dia_ux=a dia_uy=a dia_wx=a dia_wy=a  // live shapes: valid vertices (centre)
                                                //  until the first rotation above the picture
    FxStart
    goto sphere_enter                           // called from overscan: start at vblank
    {
        sync1                                   // --- overscan ---
            far song_player
            BreakOnSeq
            FxUpdate
            sp_tmin=a=[SPH_TMIN_BLANK]           // continue the next frame's points
            sph_points
        sphere_enter:
        sync2                                   // --- vblank ---
            sp_tmin=a=[SPH_TMIN_BLANK]           // ...finish the points (the time check leaves
            sph_points                          //  >= 449 cycles: enough for the colours below)
            FxFadeLevel                         // band colours: after the points, which use
                                                //  sp_colp as scratch (live diamond)
            x=sp_shape x?4 >={                      // logo with its back to the viewer: darker
                x=sp_frame x?[SPH_FRAMES/4] >={ x?[SPH_FRAMES*3/4] <{   // cos < 0: 90..270 degrees
                    a?[SPH_LOGO_BACKDIM+1] >={ c+ a-[SPH_LOGO_BACKDIM] }
                } }
            }
            a<< a<< a<< a<< a<< sp_colp=a                                // level * 32 (SphCol page aligned)
            x=songpos_seq a=SphSongMode,x x?[SPH_LOGO_SEQ] >={ a=[SPH_LOGO_PAGE] }
            x?[SPH_ALTAIR_SEQ_END] <{ a=[SPH_ALTAIR_PAGE] }                 // Altair: grey
            c- a+&>SphCol sp_colp+1=a                   // page = song mood (logo: Atari red)
        sync3                                   // --- picture ---
            // the SPH_TOP blank lines above the dots: the next frame's music + animation step
            // (+ the live diamond's rotation), timed by the RIOT timer instead of counted lines
            TIM64T=a=[SPH_TOP_TIM]
            sph_music
            a=sp_shape a?3 =={ far dia_setup1 }       // live shapes: rotate the vertices
            else { a?2 =={ far pyr_setup2 } else { a?1 =={ far cub_setup2 } } }
            timwait wsync                       // = line SPH_TOP
            TIM64T=a=[SPH_BOT_TIM]              // re-armed for the rest of the picture: same end line,
            x=0                                 //  64-cycle units for the point phase below (armed
            sph_kernel                          //  here, not after the kernel: a positioning line
                                                //  can run long during explosions (x at the edge))
            // below the sphere: ~34 idle lines -> the next frame's points (the kernel has
            // already read and cleared every band)
            sp_i=a=0 sp_tmin=a=[SPH_TMIN_BLANK]
            sph_points
    } always
}
